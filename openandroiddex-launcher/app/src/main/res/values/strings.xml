    <string name="st_notif_header">Phone notifications</string>
    <string name="st_notif_show">Show notifications on the desktop</string>
    <string name="st_notif_show_sub">A bell in the taskbar tray, with the phone’s own buttons on each one</string>
    <string name="st_notif_popup">Pop up when they arrive</string>
    <string name="st_notif_popup_sub">A card in the bottom corner for a few seconds, the way your computer does it</string>
