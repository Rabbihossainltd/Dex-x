<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Taskbar floats above app windows as a TYPE_APPLICATION_OVERLAY.
         Must be DECLARED here or `appops set SYSTEM_ALERT_WINDOW allow`
         silently stays "default" and canDrawOverlays() returns false. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The cable-pulled undo (UnplugWatch): a restarting adbd kills the window
         daemon that would otherwise put the phone's settings back. Granted by
         the PC over adb (`pm grant`) for a desktop session and revoked when it
         ends; declared here or the grant is refused. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Home button: bring the desktop task back over app windows -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- INTERNET: the loopback socket to the wmd daemon (127.0.0.1:7191) AND the
         Linux feature — downloading the Ubuntu rootfs, and every guest socket
         (apt, the noVNC loopback). Without it an app cannot create ANY socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Linux runtime (proot → Xvnc + websockify) is a long-running native
         process tree the app owns; it lives in a foreground service so Android
         does not reap it while the desktop window is backgrounded. specialUse:
         a self-hosted Linux container is none of the predefined FGS types. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- REQUIRED by libwebrtc, not by our own code. When the first peer
         connection starts gathering, NetworkMonitorAutoDetect is built ON THE
         NETWORK THREAD and immediately asks ConnectivityManager for the
         network state — a SecurityException there comes back through JNI glue
         that turns any pending Java exception into RTC_CHECK → abort(). So
         missing this is not a degraded viewer, it is SIGABRT in
         libjingle_peerconnection_so the moment a browser joins. Install-time
         grant; no dialog. (ACCESS_WIFI_STATE is NOT needed: the SSID lookup
         reads the STATE_CHANGE broadcast's extra, not getConnectionInfo.) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <!-- Remote access (LinuxRemote, RemoteHost). All three are install-time
         grants except the battery one, whose request is the platform's own
         dialog, raised only from the Remote access window when the user turns
         it on.

         WAKE_LOCK: held while a computer is connected (a CPU that sleeps
         between keystrokes makes an SSH session crawl and lets the NAT mapping
         lapse) and while charging, never otherwise.
         RECEIVE_BOOT_COMPLETED: remote access is something the user switched
         on and expects to stay on, reboots included.
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: without the exemption Doze
         defers an idle phone's network and the service cannot be restarted
         from the background — "reachable from anywhere" would quietly stop
         being true. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ package visibility: we enumerate launchable apps, and —
         as a widget host — every app that ships an AppWidget provider,
         including the ones with no launcher activity of their own. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- The file manager a dropped file's "Open" button hands off to
             (TransferHud). Without this the query comes back empty on a
             device whose Downloads UI has no launcher icon of its own. -->
        <intent>
            <action android:name="android.intent.action.VIEW_DOWNLOADS" />
        </intent>
        <!-- The phone's media-output picker, whichever of these it has. There
             is no standard one — see DexMedia.openOutputSwitcher for what each
             is and which phones carry it. Declared here because package
             visibility hides them all otherwise: the chain would judge every
             candidate absent and fall through to its last resort on a phone
             that has the first. -->
        <intent>
            <action android:name="android.settings.panel.action.MEDIA_OUTPUT" />
        </intent>
        <intent>
            <action android:name="com.android.systemui.action.LAUNCH_MEDIA_OUTPUT_DIALOG" />
        </intent>
        <intent>
            <action android:name="com.android.systemui.action.OPEN_MEDIA_OUTPUT" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
    </queries>

    <!-- An app with no android:icon gets the platform's default one — the green
         robot — and that is what the phone's app list, our own app drawer and,
         most visibly, the starting window of every desktop cold start showed. -->
    <!-- networkSecurityConfig: targetSdk 35 blocks cleartext http, which
         includes the loopback noVNC page LinuxActivity loads. The config
         permits cleartext for 127.0.0.1 and nothing else. -->
    <!-- extractNativeLibs=true: proot must be a real file in nativeLibraryDir to
         be exec'd (see build.gradle useLegacyPackaging). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.OpenAndroidDeX">
        <provider
            android:name=".RequestProvider"
            android:authorities="com.ccrstech.openandroiddex.launcher.requests"
            android:exported="true" />


        <!-- Files a computer dropped on one of those windows, for the app they
             were dropped on: not exported, so only the app a drop grants a
             file to may read it (DropsProvider). -->
        <provider
            android:name=".DropsProvider"
            android:authorities="com.ccrstech.openandroiddex.launcher.drops"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- `density` IS handled here (see onConfigurationChanged): while the
             desktop sits paused behind an app window the system defers an
             activity relaunch indefinitely, which would leave the overlay
             taskbar at the old scale after a display-size change. Handling
             the config change ourselves lets the launcher rebuild its UI
             in place the moment `wm density` lands.

             This activity has the package's default (implicit) taskAffinity
             and is the HOME task of the desktop display, so anything started
             from it WITHOUT FLAG_ACTIVITY_NEW_TASK joins the desktop's own
             task — and launch bounds are a property of the task. See
             WidgetDetourActivity for what that cost once. -->
        <!--
             The app's ONLY screen: connected or not, and a way to disconnect.
             Nothing else — no desktop, no settings, no launcher.

             launchMode singleTask with its own affinity, so tapping the icon
             twice brings the same screen back instead of stacking copies, and
             so it never joins the desktop's task (which would drag the desktop
             into whatever window this screen happens to occupy).
        -->
        <activity
            android:name=".ConnectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.ccrstech.openandroiddex.launcher.connect"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- NOT resizeable, and that is the whole point.

             A resizeable activity may be placed in a freeform task, and on a
             desktop-mode display every freeform task wears the platform's own
             caption — minimise, maximise, close, in One UI's colours, above the
             desktop's wallpaper. Our caption service already refuses to dress
             our home (see isDesktopActivity), which left the platform's strip as
             the only one still on it: "home a ekhono caption bar ache". A
             non-resizeable activity can only be fullscreen, and a fullscreen
             task has no caption to draw. The desktop is fullscreen by design. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode">
            <!--
                 Deliberately NO intent filter.

                 This activity is the desktop, and the desktop only ever exists
                 on a display the computer made: the computer starts it with an
                 `am start` addressed at this component and that display, which
                 needs no intent filter at all. A MAIN/LAUNCHER filter put it in
                 the phone's app list and a HOME filter offered it as the
                 phone's home screen, and both are exactly what this app is
                 not. The app's one screen is ConnectActivity; see it for why.

                 Exported stays true: the computer's adb shell launches this
                 from another uid.
            -->
        </activity>
        <!-- In-desktop Settings window (Display size). singleTask so
             re-opening it refocuses the existing window instead of stacking
             duplicates. taskAffinity MUST differ from the launcher's:
             singleTask joins any task with a matching affinity, and with the
             default (shared) affinity Settings lands INSIDE the launcher's
             task — dragging the whole desktop into the small freeform window
             and leaving a black display behind ("dark screen" on close). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_label"
            android:launchMode="singleTask"
            android:taskAffinity="com.ccrstech.openandroiddex.launcher.settings"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

                <!-- One Linux app's window (doc/linux-windows.md): each X window on the
             guest's window display gets a task of its own, so it wears the
             desktop's title bar and has a taskbar button like any app.

             standard + launched with NEW_TASK | MULTIPLE_TASK: a new task per
             window, under an affinity of its own so none of them ever joins —
             or drags — the launcher's task (the trap SettingsActivity's
             comment describes). excludeFromRecents: the window belongs to a
             process in the guest, and a task restored without it shows
             nothing; LinuxWindowActivity finishes such a task at once anyway.

             Every configuration change is handled in place: rebuilding the
             activity would take the surface from under a window mid-resize. -->
                                                <!-- In-desktop File transfer window: the computer's drives on the
             left, this phone's storage on the right, and the buttons between
             them that copy a selection either way. Same task rules as
             Settings, Linux, Docker and the Web viewer, for the same reasons.

             No new permission: it speaks to the computer over INTERNET (the
             loopback port adb reverses onto this device, exactly as the Web
             viewer speaks over loopback) and reads storage under the
             MANAGE_EXTERNAL_STORAGE this package already declares. -->
        <activity
            android:name=".FileTransferActivity"
            android:exported="false"
            android:label="@string/ft_label"
            android:launchMode="singleTask"
            android:taskAffinity="com.ccrstech.openandroiddex.launcher.filetransfer"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

                <!-- The tray's performance gauge opens this. Same task rules as
             Settings and Linux, for the same reasons. -->
        <activity
            android:name=".TaskManagerActivity"
            android:exported="false"
            android:label="@string/tm_title"
            android:launchMode="singleTask"
            android:taskAffinity="com.ccrstech.openandroiddex.launcher.taskmanager"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- What the touchpad's notification opens (TouchpadNotice): it puts the phone's
             own screen up as the desktop's touchpad — an overlay window, see Touchpad and
             doc/phone-touchpad.md — and finishes before it draws. A trampoline because a
             notification that opens an activity is one the shade closes itself for.

             It owns a task, is out of Recents and draws nothing — the task-shaped hole
             LinuxAppActivity and WebConsentActivity are, under an affinity of its own for
             the reason SettingsActivity spells out. -->
        <activity
            android:name=".TouchpadActivity"
            android:exported="false"
            android:label="@string/lx_pad_title"
            android:launchMode="singleTask"
            android:taskAffinity="com.ccrstech.openandroiddex.launcher.touchpad"
            android:theme="@style/Theme.OpenAndroidDeX.Detour"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale" />

        <!-- Trampoline for the widget flow's two system detours (the bind
             confirmation, the provider's configure screen). It exists only to
             own a TASK: an activity started FOR A RESULT lands in the CALLER's
             task, and ActivityOptions launch bounds are applied to that task —
             so calling startActivityForResult from the desktop resized the
             desktop, drawing the whole shell inside the dialog's 520dp window
             with the display black around it. FLAG_ACTIVITY_NEW_TASK is not
             the way out: it severs resultTo, which cancels our result AND
             leaves the bind dialog's getCallingPackage() null, so it finishes
             before it draws.

             taskAffinity for the same reason spelled out on SettingsActivity
             above: with the launcher's (default) affinity a singleTask
             activity joins the desktop's task and reproduces the exact bug
             this class exists to fix. NOT singleInstance — the whole point is
             that another activity may join THIS task. NOT noHistory and NOT
             finishOnTaskLaunch: this activity sits BEHIND the dialog it is
             waiting on, and either one would finish it there and lose the
             result. -->
        <activity
            android:name=".WidgetDetourActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.ccrstech.openandroiddex.launcher.detour"
            android:theme="@style/Theme.OpenAndroidDeX.Detour"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale" />

        <!-- Per-window title bars. This is an AccessibilityService only because
             attachAccessibilityOverlayToWindow() is the one API that reparents our
             surface INTO the target app's own window surface — which is what makes the
             caption impossible to separate from its window. See CaptionService. -->
        <service
            android:name=".CaptionService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/caption_service" />
        </service>

        <!-- The phone's notifications on the desktop, and — through the same
             grant — the media transport in the quick-settings panel.

             A NotificationListenerService is the ONLY way an ordinary app may
             read notifications, and MediaSessionManager#getActiveSessions is
             gated on an enabled listener COMPONENT rather than on a permission
             of its own, so this one declaration carries both features. That is
             also why there is no MEDIA_CONTENT_CONTROL here: it is a signature
             permission a third-party app can never hold, and the listener route
             is the supported one.

             android:permission is REQUIRED and is the platform's half of the
             contract: it says only the system may bind us. Without it the
             service is not recognised as a listener at all and never appears on
             the notification-access screen.

             android:process — deliberately NONE, unlike LinuxService and
             DockerService. Its whole audience is in the launcher's process: the
             taskbar draws the flyout, the call banner is one of the launcher's
             own overlay windows, and both read the list through plain statics
             (DexNotifications) rather than over a binder.

             exported is implied by the intent-filter and is correct here — the
             system is the only caller the permission above admits. -->
        <!-- Dex-X in the notification panel.
             A quick-settings tile is bound by the system, so it must be exported
             and guarded by BIND_QUICK_SETTINGS_TILE — anything else lets a third
             party bind this and drive it. The label and icon are the tile's, not
             the app's: the system draws them at 24 dp in its own colour. -->
        <service
            android:name=".DexTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_dex"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".DexNotifications"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>


    </application>
</manifest>
